# Image Uploader Bot — environment variables
# Copy this file to .env or set these in the Koyeb dashboard.

# Required: Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Required: Channel username (make the bot an admin there first)
CHANNEL_USERNAME=@YourChannelUsername

# Optional: MongoDB connection string (enables /users and user tracking)
MONGO_URI=

# Optional: official imgBB API key (https://api.imgbb.com).
# When set, uploads are tried on the official imgBB API first,
# then the built-in imgBB proxy, then the keyless fallback host.
IMGBB_API_KEY=

# Optional: custom https:// URL for the /start welcome image.
# By default the bot rotates 20 bundled images served from its own
# webhook URL (assets/welcome/welcome-01.jpg .. welcome-20.jpg).
WELCOME_IMAGE_URL=

# Optional: port the webhook server listens on (Koyeb sets this to 8000)
PORT=8000
